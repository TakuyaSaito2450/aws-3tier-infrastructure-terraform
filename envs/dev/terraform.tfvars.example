# このファイルを terraform.tfvars にコピーして値を埋める。
# terraform.tfvars は .gitignore 対象 (自宅IPなどを含むため)。

project = "portfolio"
env     = "dev"
owner   = "saito"
region  = "ap-northeast-1"

# 検証中はALBへのアクセスを自宅IPに限定する
ingress_cidr = "203.0.113.10/32"

# --- コスト優先の設定 (検証時) ---
single_nat_gateway = true
db_multi_az        = false
desired_capacity   = 2

# --- 本番相当のデモをする場合はこちら ---
# single_nat_gateway = false
# db_multi_az        = true

alert_email = "you@example.com"

#!/bin/bash
set -euo pipefail

# ------------------------------------------------------------
# 検証用の最小構成。
# ポートフォリオの評価対象はアプリではなく基盤側のため、
# 起動確認とヘルスチェック応答ができれば十分と判断。
# ------------------------------------------------------------

dnf -y update
dnf -y install nginx amazon-cloudwatch-agent

# ALBヘルスチェック用エンドポイント
mkdir -p /usr/share/nginx/html
echo "ok" > /usr/share/nginx/html/health

TOKEN=$(curl -sX PUT "http://169.254.169.254/latest/api/token" \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" \
  http://169.254.169.254/latest/meta-data/instance-id)
AZ=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" \
  http://169.254.169.254/latest/meta-data/placement/availability-zone)

cat > /usr/share/nginx/html/index.html <<HTML
<!doctype html>
<html lang="ja">
<head><meta charset="utf-8"><title>3-tier portfolio</title></head>
<body>
  <h1>AWS 3-tier Web Infrastructure</h1>
  <p>Instance: $INSTANCE_ID</p>
  <p>AZ: $AZ</p>
</body>
</html>
HTML

sed -i "s/listen       80;/listen       ${app_port};/" /etc/nginx/nginx.conf

systemctl enable --now nginx
systemctl enable --now amazon-cloudwatch-agent
